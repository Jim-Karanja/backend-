# Copy to .env and replace placeholders before live collection.
# Leave DATABASE_URL empty to use temporary in-memory storage.
DATABASE_URL=
# Demo is enabled by default. Set false to use real platform APIs.
HUB_DEMO_MODE=true
AUTHOR_HASH_SALT=
FB_PAGE_TOKEN=
X_BEARER_TOKEN=
X_USER_TOKEN=
# Used by the background classifier and the AI/MCP classification tool.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OpenAI-compatible endpoint. Defaults to OpenAI. Examples:
#   OpenAI:            https://api.openai.com/v1
#   OpenCode Console:  https://opencode.ai/inference/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Request style: "responses" (OpenAI /responses API) or "chat" (/chat/completions).
OPENAI_API_STYLE=responses
# Background classifier: classifies the oldest unclassified complaints on a timer.
AUTO_CLASSIFY=true
# Seconds between automatic classifications (min 30).
AUTO_CLASSIFY_INTERVAL=300
# Complaints classified per automatic run (1-25).
AUTO_CLASSIFY_BATCH=10
# Comma-separated browser origins allowed to call this API (no trailing slash).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
