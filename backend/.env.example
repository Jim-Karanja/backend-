# Copy to .env and replace placeholders before live collection.
# Leave DATABASE_URL empty to use temporary in-memory storage.
DATABASE_URL=
# Demo is enabled by default. Set false to use real platform APIs.
HUB_DEMO_MODE=true
AUTHOR_HASH_SALT=
FB_PAGE_TOKEN=
X_BEARER_TOKEN=
X_USER_TOKEN=
# Used only when you click Classify or call the AI/MCP classification tool.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Comma-separated browser origins allowed to call this API (no trailing slash).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
